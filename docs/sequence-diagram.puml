@startuml
title Sequence - join, chat, allUsers, leave

actor Alice
participant "ClientApp (view)" as ClientView
participant ChatClient as Client
participant ClientHandler as Handler
participant ChatServer as Server
participant "ServerApp (view)" as ServerView

Alice -> ClientView : enter username and click JOIN
ClientView -> Client : connect(host, port, username)
Client -> Handler : HELLO Alice
Handler -> Server : register()
Handler --> Client : OK
Server -> ServerView : onLog Welcome Alice, onUserJoined
ClientView -> Client : startListening()

Alice -> ClientView : type message and press Enter
ClientView -> Client : handleInput(text)
Client -> Handler : MSG text
Handler -> Server : broadcastChat()
Server --> Client : CHAT time, user, text (sent to all clients)

Alice -> ClientView : type allUsers
Client -> Handler : ALLUSERS
Handler --> Client : USERS list of active users

Alice -> ClientView : type bye or click LEAVE
Client -> Handler : LEAVE
Handler --> Client : BYE
Handler -> Server : remove()
Server -> ServerView : onUserLeft(Alice)
@enduml