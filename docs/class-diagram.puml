@startuml
title Class Diagram - Multi-Client Chat (Model / View separation)
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "Server application" {
  class TCPServer <<launcher>> {
    +main(args)
  }

  package "server.view" {
    class ServerApp {
      -users : ObservableList
      -colors : Map
      +start(Stage)
    }
  }

  package "server.model" {
    interface ServerListener {
      +onLog(msg)
      +onUserJoined(user)
      +onUserLeft(user)
    }
    class ChatServer {
      -clients : List
      +start()
      +stop()
      ~register(handler, name)
      ~broadcastChat(sender, text)
      ~broadcast(line)
      ~remove(handler)
      ~userNames()
    }
    class ClientHandler <<virtual thread>> {
      -username : String
      +run()
      ~send(line)
      ~isReadOnly()
    }
    class ServerConfig <<record>> {
      host
      port
      +load()
    }
    class ServerProtocol {
      +build()
      +parse()
    }
  }
}

package "Client application" {
  class TCPClient <<launcher>> {
    +main(args)
  }

  package "client.view" {
    class ClientApp {
      +start(Stage)
      -showLogin()
      -showChat()
    }
  }

  package "client.model" {
    interface ChatListener {
      +onMessage()
      +onUsers()
      +onDisconnected()
    }
    class ChatClient {
      -socket : Socket
      +connect(host, port, user)
      +startListening()
      +handleInput(text)
      +disconnect()
    }
    class ClientConfig <<record>> {
      host
      port
      +fromArgs()
    }
    class ClientProtocol {
      +build()
      +parse()
    }
  }
}

TCPServer ..> ServerApp : launches
ServerApp ..|> ServerListener
ServerApp --> ChatServer : uses
ServerApp ..> ServerConfig
ChatServer o-- "0..*" ClientHandler
ChatServer --> ServerListener : notifies
ChatServer ..> ServerProtocol
ClientHandler ..> ServerProtocol

TCPClient ..> ClientApp : launches
ClientApp --> ChatClient : uses
ClientApp ..|> ChatListener
ChatClient --> ChatListener : notifies
ClientApp ..> ClientConfig
ChatClient ..> ClientProtocol

ClientHandler .. ChatClient : TCP text protocol
@enduml