@startuml
title Deployment Diagram

node "Server machine (JVM 21)" as ServerNode {
  artifact "TCPServer.jar" as ServerJar
  artifact "config.properties" as ServerConfigFile
  component "ChatServer (virtual thread per client)" as ChatServerComp
}

node "Client machine A (JVM 21)" as ClientA {
  artifact "TCPClient.jar" as ClientJarA
}

node "Client machine B (JVM 21)" as ClientB {
  artifact "TCPClient.jar" as ClientJarB
}

node "Client machine N (JVM 21)" as ClientN {
  artifact "TCPClient.jar" as ClientJarN
}

ClientJarA -- ChatServerComp : TCP/IP port 3000
ClientJarB -- ChatServerComp : TCP/IP port 3000
ClientJarN -- ChatServerComp : TCP/IP port 3000
ServerConfigFile ..> ChatServerComp : loaded at startup
@enduml